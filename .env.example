APP_NAME=MioPersonal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://miopersonal.test

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# In locale le email finiscono in storage/logs/laravel.log. In produzione con Brevo (vedi il README):
# MAIL_MAILER=smtp, MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587,
# MAIL_USERNAME=<login SMTP di Brevo>, MAIL_PASSWORD=<chiave SMTP di Brevo>,
# MAIL_FROM_ADDRESS="noreply@miopersonal.it"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CONTACT_ADDRESS=info@miopersonal.it

# Search engines and AI assistants (App\Support\IndexNow, Organization JSON-LD of the home).
# INDEXNOW_KEY: a random string (php -r "echo bin2hex(random_bytes(16));"); empty = no pings.
# APP_SAME_AS: the brand's social profiles, comma separated.
INDEXNOW_KEY=
APP_SAME_AS=

# "Continua con Google": empty = the button is hidden (see the README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# "Collega Google Calendar" (trainer settings): uses the same GOOGLE_CLIENT_ID/SECRET as the login,
# with the Google Calendar API turned on and this redirect added on the Google console.
GOOGLE_CALENDAR_REDIRECT_URI="${APP_URL}/area-trainer/calendario-google/callback"

# "Collega" the socials of the trainer profile: empty = that button is hidden.
# Callbacks to register on each console: ${APP_URL}/social/{instagram|tiktok|facebook|youtube}/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Notifiche push: empty = "Attiva le notifiche" is hidden. Create them once with
# `php artisan webpush:vapid` and never change them (the devices would stop receiving).
VAPID_SUBJECT="mailto:info@miopersonal.it"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Error tracking (Sentry, free Developer plan): empty DSN = turned off, nothing is sent.
# One Sentry project for Laravel and one for React; the DSN of the browser one is public.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_RELEASE=
# Keep it 0: performance monitoring would eat the free quota.
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT="${APP_ENV}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
