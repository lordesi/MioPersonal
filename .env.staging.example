# Il .env del sito staging.miopersonal.it (vedi docs/staging.md).
# Va copiato come .env sul server di staging: mai su GitHub con valori veri.

APP_NAME=MioPersonal
# "staging" attiva password, noindex, email intrappolate e dati finti.
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.miopersonal.it

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Un database SOLO per staging: "staging:reset" lo svuota.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=miopersonal_staging
DB_USERNAME=miopersonal_staging
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Chiude il sito: senza questi due il sito risponde 503.
STAGING_USER=team
STAGING_PASSWORD=

# Le email finiscono comunque nel log (il codice lo forza), ma lascia "log" anche qui.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@staging.miopersonal.it"
MAIL_FROM_NAME="${APP_NAME} (staging)"
MAIL_CONTACT_ADDRESS=staging@miopersonal.it

# Google: gli stessi della produzione, con i redirect di staging aggiunti nella console Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_CALENDAR_REDIRECT_URI="${APP_URL}/area-trainer/calendario-google/callback"

# Lasciati vuoti: i pulsanti non compaiono e non parte nulla.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
VAPID_SUBJECT="mailto:staging@miopersonal.it"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Sentry: un progetto/DSN diverso da quello di produzione. Vuoto = spento.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=staging
